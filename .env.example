# ===== 模型 API 配置 =====
# DeepSeek 官网（本项目 DeepSeek 模型统一使用 deepseek-v4-flash）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 阿里百炼（OpenAI 兼容模式；qwen / glm 等阿里直供模型）
ALIBABA_API_KEY=sk-your-dashscope-api-key
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== 模型名称（切换模型只改这里，无需改代码） =====
# 主 Agent / 异步采购分析子 Agent 模型（DeepSeek 官网）
DEEPSEEK_MODEL=deepseek-v4-flash
# 摘要模型（DeepSeek 官网）
SUMMARY_MODEL=deepseek-v4-flash
# 备用模型（阿里百炼，主模型故障时兜底）
FALLBACK_MODEL=glm-5.2
# 联网搜索模型（阿里百炼，需支持 enable_search 的 qwen 系列模型；
# 配成非 qwen 模型时自动降级为无联网的自身知识回答，见 web_search.py）
WEB_SEARCH_MODEL=qwen-plus

# ===== Java ERP 后端 API 地址 =====
# 你的汽车配件 ERP 后端（本项目不含 Java 侧代码，需自行部署并填写地址）
JAVA_API_BASE_URL=http://127.0.0.1:8081/api

# ===== 本地基础设施（Docker 部署） =====
# MongoDB（checkpoint / 会话历史持久化）
MONGODB_URI=mongodb://root:your-password@127.0.0.1:27017/?authSource=admin
# OpenSandbox 沙箱服务端（opensandbox-server，见 .sandbox.toml）
SANDBOX_DOMAIN=http://127.0.0.1:8080

# 图表 MCP（AntV mcp-server-chart，本机自托管，用 npm 全局安装后启动：
#   node "$(npm root -g)/@antv/mcp-server-chart/build/index.js" --transport streamable --port 1122 --host 127.0.0.1
# 注意 --host 127.0.0.1 不能省：默认 localhost 在 Node 24 下只监听 IPv6 ::1，
# 而 httpx 走系统代理回连 127.0.0.1 会失败（502））
ANALYSIS_MCP_URL=http://127.0.0.1:1122/mcp
